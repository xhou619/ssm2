<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.ssm2.mapper.ClassMapper">
    <select id="findStudentsById" parameterType="Integer" resultMap="classWithStudentsResult">
        select c.*, ss.id as sid, ss.code, s.id as uid, s.name as sname, s.sex
        from t_class c,
             t_student s,
             t_student_id ss
        where c.id = s.cid
          and s.sid = ss.id
          and c.id = #{id}
    </select>
    <resultMap id="classWithStudentsResult" type="com.example.ssm2.po.Class">
        <id property="id" column="id" />
        <result property="name" column="name" />
        <collection property="students" ofType="com.example.ssm2.po.Student">
            <id property="id" column="uid" />
            <result property="name" column="sname" />
            <result property="sex" column="sex" />
            <association property="sid" javaType="com.example.ssm2.po.StudentID">
                <id property="id" column="sid" />
                <result property="code" column="code" />
            </association>
        </collection>
    </resultMap>
</mapper>