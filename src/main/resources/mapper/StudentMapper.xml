<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.ssm2.mapper.StudentMapper">
    <select id="findStudentById" parameterType="Integer" resultMap="studentWithIdResult">
        select *
        from t_student
        where id = #{id}
    </select>
    <resultMap id="studentWithIdResult" type="com.example.ssm2.po.Student">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="sex" column="sex"/>
        <association property="sid" column="sid" javaType="com.example.ssm2.po.StudentID"
                     select="com.example.ssm2.mapper.StudentIDMapper.findCodeById"/>
    </resultMap>
    <select id="findStudentById2" parameterType="Integer" resultMap="studentWithId2Result">
        select s.*, card.*
        from t_student s,
             t_student_id card
        where s.sid = card.id
          and s.id = #{id}
    </select>
    <resultMap id="studentWithId2Result" type="com.example.ssm2.po.Student">
        <id property="id" column="id" />
        <result property="name" column="name" />
        <result property="sex" column="sex" />
        <association property="sid" javaType="com.example.ssm2.po.StudentID">
            <id property="id" column="id" />
            <result property="code" column="code" />
        </association>
    </resultMap>
</mapper>