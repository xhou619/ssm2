<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.ssm2.mapper.CourseMapper">
    <select id="findCourseWithStudents" parameterType="Integer" resultMap="courseWithStudentsResult">
        select c.*, s.id as uid, s.name as sname, s.sex, card.id as sid, card.code as scode
        from t_course c,
             t_student s,
             t_student_id card,
             t_elective_course ec
        where c.id = #{id}
          and s.id = ec.uid
          and ec.cid = c.id
          and card.id = s.sid
    </select>
    <resultMap id="courseWithStudentsResult" type="com.example.ssm2.po.Course">
        <id property="id" column="id" />
        <result property="name" column="name" />
        <result property="code" column="code" />
        <collection property="students" ofType="com.example.ssm2.po.Student">
            <id property="id" column="uid" />
            <result property="name" column="sname" />
            <result property="sex" column="sex" />
            <association property="sid" javaType="com.example.ssm2.po.StudentID">
                <id property="id" column="sid" />
                <result property="code" column="scode" />
            </association>
        </collection>
    </resultMap>
</mapper>